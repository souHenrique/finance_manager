# Set these values as secrets in the Render dashboard. Do not commit a real .env.production file.
# Use the Supabase Session Pooler JDBC URL (port 5432) with SSL required.
DB_URL=jdbc:postgresql://replace-with-session-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=postgres.replace-with-project-ref
DB_PASSWORD=replace-with-supabase-database-password
JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION=3600000

# Use the final Vercel production URL or custom frontend domain, without a trailing slash.
CORS_ALLOWED_ORIGINS=https://replace-with-project.vercel.app
